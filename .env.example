# 🔐 ENVIRONMENT VARIABLES - Metodologia-Scrape
# Copy this file to .env and fill with your actual values

## Firecrawl API (Fase 3)
# Get your API key from: https://firecrawl.dev/dashboard
FIRECRAWL_API_KEY=fc-your_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

## Puppeteer Stealth (Fase 2)
# Control headless mode (true = background, false = visible browser)
HEADLESS=true

# Output directory for captures
OUTPUT_DIR=./captures

## Playwright (Fase 3 - Multi-browser)
# Options: chromium, firefox, webkit
BROWSER=chromium

## MCP Server
# Port for MCP server (if running standalone)
MCP_PORT=3000

## Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

## Advanced
# Timeout for page loads (milliseconds)
PAGE_TIMEOUT=30000

# Retry attempts for failed scrapes
MAX_RETRIES=3

# Wait time between retries (milliseconds)
RETRY_DELAY=5000
